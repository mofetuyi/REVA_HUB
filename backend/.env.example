# =============================================================================
# Reva Hub – Environment Variables Template
# Copy this file to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# --- Application ---
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-long-random-string-in-production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

# --- Database ---
DATABASE_URL=postgresql+asyncpg://reva:reva_dev_password@localhost:5432/reva_db

# --- Redis (for OTP, job queue) ---
REDIS_URL=redis://localhost:6379

# --- JWT Tokens ---
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- SMS OTP Provider ---
# Supported providers: termii | africas_talking
SMS_PROVIDER=termii
SMS_API_KEY=your_sms_provider_api_key_here
SMS_SENDER_ID=Reva

# --- KYC Provider (Smile Identity or similar) ---
KYC_PROVIDER_URL=https://api.kyc-provider.com
KYC_API_KEY=your_kyc_api_key_here
KYC_WEBHOOK_SECRET=your_kyc_webhook_secret_here

# --- Payment Provider (Paystack) ---
# NOTE: True escrow capability for this use case requires verification with Paystack.
# Do NOT enable production payment processing until escrow behavior is confirmed.
PAYMENT_PROVIDER=paystack
PAYMENT_SECRET_KEY=sk_test_your_paystack_secret_key_here
PAYMENT_PUBLIC_KEY=pk_test_your_paystack_public_key_here
PAYMENT_WEBHOOK_SECRET=your_paystack_webhook_secret_here

# --- Object Storage (S3-compatible, e.g. AWS S3 or Cloudflare R2) ---
S3_BUCKET_NAME=reva-uploads
S3_ACCESS_KEY=your_s3_access_key_here
S3_SECRET_KEY=your_s3_secret_key_here
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_REGION=us-east-1

# --- Gemini AI ---
# Server-side only. Never expose this key in frontend code.
GEMINI_API_KEY=your_gemini_api_key_here

# --- Resend Email ---
# Server-side only. Never expose this key in frontend code.
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com

# =============================================================================
# Business Rules (configurable, do not hard-code in application logic)
# =============================================================================

# Marketplace commission rate (default 6%; range under evaluation: 5–8%)
MARKETPLACE_COMMISSION_RATE=0.06

# Payment processing fee rate assumption (actual fee from provider when available)
PAYMENT_PROCESSING_FEE_RATE=0.025
PAYMENT_PROCESSING_FEE_MIN_NGN=50

# OPEN DECISION: Escrow auto-release trigger
# Conflict: spec mentions both "14 days after order creation" and "14 days after buyer confirmation".
# Provisional safe default: 14 days AFTER buyer delivery confirmation.
# Do NOT enable real escrow release until trigger is approved and provider confirmed.
ESCROW_RELEASE_DAYS_AFTER_CONFIRM=14
ESCROW_AUTO_RELEASE_ENABLED=false

# Listing lifecycle
LISTING_EXPIRY_DAYS=90
LISTING_RENEWAL_PROMPT_DAY=85
OFFER_EXPIRY_DAYS=7
DELIVERY_REMINDER_DAYS=7

# Verified seller badge thresholds
VERIFIED_SELLER_MIN_ORDERS=5
VERIFIED_SELLER_MIN_RATING=4.0
VERIFIED_SELLER_DISPUTE_LOOKBACK_DAYS=30
